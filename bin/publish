#!/bin/bash
# Draft → _posts → GitHub Pages. Agents run: prepare → (user approves) → push → check.
set -euo pipefail

DRAFTS="$HOME/Documents/org/writing"
BLOG="$(cd "$(dirname "$0")/.." && pwd)"
SITE="https://lukia00.github.io"

die() { echo "오류: $*" >&2; exit 1; }

find_draft() {
  local matches
  matches=$(find "$DRAFTS" -maxdepth 1 -name "*$1*.md" | sort)
  [ -n "$matches" ] || die "'$1'에 맞는 초안이 $DRAFTS 에 없습니다"
  [ "$(echo "$matches" | wc -l)" -eq 1 ] || die "여러 초안이 맞습니다:
$matches"
  echo "$matches"
}

post_url() {
  # minima default permalink: /YYYY/MM/DD/slug.html
  local base; base=$(basename "$1" .md)
  echo "$SITE/${base:0:4}/${base:5:2}/${base:8:2}/${base:11}.html"
}

cmd_prepare() {
  local draft name
  draft=$(find_draft "$1")
  name=$(basename "$draft")
  [[ "$name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+\.md$ ]] \
    || die "파일명이 YYYY-MM-DD-slug.md 형식이 아닙니다 (slug는 영문 소문자·숫자·-): $name"
  [ "$(head -1 "$draft")" = "---" ] || die "Front Matter(---)로 시작하지 않습니다: $name"
  awk 'NR>1 && /^---$/ {exit} /^title: *[^ ]/ {found=1} END {exit !found}' "$draft" \
    || die "Front Matter에 title이 없습니다: $name"
  # Jekyll silently drops future-dated posts, so the build "succeeds" with no post.
  local fm_date
  fm_date=$(awk 'NR>1 && /^---$/ {exit} /^date:/ {sub(/^date: */, ""); print}' "$draft")
  if [ -n "$fm_date" ]; then
    local ts
    ts=$(date -j -f "%Y-%m-%d %H:%M:%S %z" "$fm_date" +%s 2>/dev/null) \
      || die "date 형식을 읽을 수 없습니다 (YYYY-MM-DD HH:MM:SS +0900): $fm_date"
    [ "$ts" -le "$(date +%s)" ] || die "date가 미래입니다 ($fm_date). 미래 글은 게시되지 않습니다"
  fi

  mkdir -p "$BLOG/_posts"
  cp "$draft" "$BLOG/_posts/$name"
  cd "$BLOG"
  echo "== 준비됨: _posts/$name"
  echo "== 발행 주소(예정): $(post_url "$name")"
  echo "== git 변경 사항:"
  git status --short
}

cmd_push() {
  cd "$BLOG"
  local msg="${1:-}"
  [ -n "$msg" ] || die "커밋 메시지가 필요합니다: publish push \"메시지\""
  git add -A
  git diff --cached --quiet && die "커밋할 변경이 없습니다"
  git commit -q -m "$msg"
  git push -q -u origin main
  echo "== push 완료: $(git log -1 --format='%h %s')"
}

cmd_check() {
  local url; url=$(post_url "$(basename "$(find_draft "$1")")")
  for _ in $(seq 1 20); do
    if [ "$(curl -s -o /dev/null -w '%{http_code}' "$url")" = "200" ]; then
      echo "== 게시 확인: $url"; return 0
    fi
    sleep 15
  done
  die "5분 안에 게시되지 않았습니다. 빌드 상태: gh run list -R lukia00/lukia00.github.io"
}

cmd_abort() {
  cd "$BLOG"
  git restore --staged _posts 2>/dev/null || true
  git restore _posts 2>/dev/null || true
  git clean -fq _posts
  echo "== 준비 취소됨"
  git status --short
}

case "${1:-}" in
  prepare) cmd_prepare "${2:?초안 이름(slug 일부)이 필요합니다}" ;;
  push)    cmd_push "${2:-}" ;;
  check)   cmd_check "${2:?초안 이름이 필요합니다}" ;;
  abort)   cmd_abort ;;
  *) echo "사용법: publish prepare <slug> | push \"메시지\" | check <slug> | abort"; exit 1 ;;
esac
